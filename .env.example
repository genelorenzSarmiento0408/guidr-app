NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key
# Optional (server-side service role key for migrations/scripts)
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# Stripe (required for premium checkout and webhook)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

# PayMongo (required for PayMongo checkout and webhook)
PAYMONGO_SECRET_KEY=sk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsec_xxx
PAYMONGO_PREMIUM_AMOUNT_CENTS=9900
PAYMONGO_CURRENCY=PHP
PAYMONGO_PAYMENT_METHOD_TYPES=card,gcash,paymaya

# Optional app URL override for callback links (defaults to request origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000